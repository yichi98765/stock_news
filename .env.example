# 全て任意。未設定でもアプリは動作（rule-base / yahoo フォールバック）。

# --- 監視対象ティッカー（カンマ区切り） ---
# 未設定なら lib/config.ts の DEFAULT_TICKERS を使用
NEXT_PUBLIC_TICKERS=NBIS,TSLA

# --- ニュース取得 (任意・未設定なら Yahoo Finance のニュースのみ) ---
# Finnhub: https://finnhub.io/ で無料登録 (60 req/min)
FINNHUB_API_KEY=

# --- AI 要約 (任意・未設定なら rule-base 要約) ---
# 優先順位: Gemini > Claude > OpenAI > rule-base

# Google Gemini (無料枠あり・推奨): https://aistudio.google.com/apikey
# モデルは複数試行されてフォールバックする (lib/ai/geminiClient.ts)
# 既定の優先順位:
#   gemini-3.1-flash-lite-preview (500 RPD) -> gemini-flash-lite-latest
#   -> gemini-2.5-flash-lite (20 RPD) -> gemini-2.0-flash-lite
#   -> gemini-flash-latest -> gemini-2.5-flash
# GEMINI_MODEL: 単一モデルを指定 (これを最優先で試す)
# GEMINI_MODELS: カンマ区切りで完全に上書き (例: "gemini-3.1-flash-lite,gemini-2.0-flash")
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODELS=

# Anthropic Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 表示言語 (現状 ja のみ実装) ---
NEXT_PUBLIC_LOCALE=ja
